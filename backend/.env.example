# Puerto donde corre el servidor Express
PORT=4000

# Connection string de MongoDB (Atlas o local). No subir credenciales reales.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/proyecto-integrador?appName=Cluster0

# Secreto usado para firmar los tokens JWT. Generar uno propio y no compartirlo.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
